# Plantilla de migración: sólo nombres y valores vacíos.
# Recuperar valores por un canal seguro y autorizado; no copiarlos al chat/GitHub.
# No se verificó que Vercel guarde toda la configuración de la PC original.
# Los valores reales van en .env.local (ignorado), usando servicios de prueba.

# Administración: no regenerar ni reutilizar claves productivas para forzar arranque.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Firestore remoto; confirmar proyecto de pruebas y base browns-studio.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Gemini. El build raíz puede enviar knowledge_base si la key está en el proceso.
GEMINI_API_KEY=
GEMINI_MODEL=

# WhatsApp / Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_FLOW_ID=
HANDOFF_NOTIFICATION_PHONE=

# Correo GEO / Resend. No enviar correos reales durante una prueba sin autorización.
RESEND_API_KEY=
GEO_MAIL_FROM=
GEO_MAIL_TO=

# Integraciones opcionales
CALENDLY_URL=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
ELEVENLABS_API_KEY=
GOOGLE_SHEETS_WEBHOOK_URL=

# Nombres presentes en la plantilla previa; confirmar necesidad antes de configurar.
WHATSAPP_BUSINESS_ACCOUNT_ID=
NEXT_PUBLIC_SITE_URL=

# NODE_ENV y VERCEL_ENV son variables de runtime; no son credenciales.
